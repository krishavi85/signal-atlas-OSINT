# ─────────────────────────────────────────────────────────────────────────────
# OSINT Platform — environment configuration
# Copy to .env and fill in. Nothing here is required to boot the platform;
# missing keys degrade the relevant connector/provider to an honest
# "NOT_CONFIGURED" state that the UI displays explicitly.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
API_PORT=4000
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# SQLite (default, zero-setup). For production swap to PostgreSQL:
#   DATABASE_URL="postgresql://user:pass@localhost:5432/osint?schema=public"
# and change datasource provider in services/api/prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./prisma/dev.db"

# --- Auth ---
# 32+ byte random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=change-me-please-32-bytes-minimum-xxxxxxxxxxxxxxxxxxx
AUTH_ACCESS_TTL=900
AUTH_REFRESH_TTL=2592000
# Credential encryption key (AES-256-GCM), 32 bytes base64url.
CREDENTIAL_ENC_KEY=change-me-32-bytes-base64url-xxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Object storage (evidence blobs, screenshots) ---
# "local" writes to ./storage. "s3" uses the S3_* vars below.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Job system ---
# "inprocess" (default) or "redis" (requires REDIS_URL + BullMQ, not bundled).
JOB_DRIVER=inprocess
REDIS_URL=

# ─────────────────────────────────────────────────────────────────────────────
# CONNECTORS  (each unset key => connector reports NOT_CONFIGURED, no fake data)
# ─────────────────────────────────────────────────────────────────────────────

# Web search — pick any subset; orchestrator uses whatever is configured.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
BING_SEARCH_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPAPI_KEY=
# Self-hosted SearXNG instance (no key needed, just a URL)
SEARXNG_BASE_URL=

# Social — official APIs only. These connectors will not scrape or bypass auth.
META_GRAPH_APP_ID=
META_GRAPH_APP_SECRET=
META_GRAPH_ACCESS_TOKEN=
INSTAGRAM_GRAPH_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_USER_ID=
YOUTUBE_DATA_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_TOKEN=

# Key-free connectors (RSS, Wikipedia, Hacker News, generic web fetch) need nothing.
# Optional polite identification for outbound requests:
HTTP_USER_AGENT=osint-platform/0.1 (+https://example.local; research use)
HTTP_CONTACT_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# AI PROVIDERS  (abstraction layer — platform runs without any of these using
# deterministic heuristic extractors; AI synthesis features degrade gracefully)
# ─────────────────────────────────────────────────────────────────────────────
AI_PROVIDER=none          # none | ollama | anthropic | openai
AI_MODEL_EXTRACT=         # small model for extraction (e.g. llama3.1:8b)
AI_MODEL_SYNTH=           # large model for synthesis  (e.g. claude-sonnet-5)
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_EMBEDDINGS_PROVIDER=none   # none | ollama | openai
AI_EMBEDDINGS_MODEL=

# --- Cost controls ---
BUDGET_MONTHLY_USD=0          # 0 = no cap (warn only)
BUDGET_LLM_TOKENS_DAY=0
