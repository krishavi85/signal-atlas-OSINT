{
  "name": "@osint/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc -b",
    "typecheck": "tsc -b",
    "dev": "node --import tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:verify": "node scripts/verify-migrations.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "load-test": "node scripts/loadtest.mjs",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "node ../../scripts/run-tests.mjs"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.1.1",
    "@osint/connectors": "*",
    "@osint/core": "*",
    "@prisma/client": "^6.1.0",
    "@types/pdfkit": "^0.17.6",
    "cron-parser": "^5.10.0",
    "docx": "^9.7.1",
    "exifr": "^7.1.3",
    "fastify": "^5.1.0",
    "image-size": "^2.0.2",
    "jimp": "^1.6.1",
    "jszip": "^3.10.2",
    "libphonenumber-js": "^1.11.20",
    "mammoth": "^1.12.2",
    "pdfkit": "^0.20.2",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "unpdf": "^1.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
