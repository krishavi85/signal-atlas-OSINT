{
  "name": "@osint/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc -b",
    "typecheck": "tsc -b --noEmit",
    "dev": "node --import tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "node --test --import tsx \"src/**/*.test.ts\""
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.1.1",
    "@osint/connectors": "*",
    "@osint/core": "*",
    "@prisma/client": "^6.1.0",
    "fastify": "^5.1.0",
    "jose": "^5.9.6",
    "mammoth": "^1.12.2",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "unpdf": "^1.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
