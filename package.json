{
  "name": "osint-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Public Intelligence, OSINT, Search & Investigation Platform",
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate -w @osint/api",
    "db:migrate": "npm run db:migrate -w @osint/api",
    "db:seed": "npm run db:seed -w @osint/api",
    "dev:api": "npm run dev -w @osint/api",
    "dev:web": "npm run dev -w @osint/web",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  }
}
